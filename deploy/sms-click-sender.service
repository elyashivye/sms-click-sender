[Unit]
Description=SMS Click Sender (local web app)
After=network.target

[Service]
Type=simple
# Change to the Linux user that has USB/adb access (member of the plugdev group)
User=CHANGE_ME
WorkingDirectory=/opt/sms-click-sender
Environment=HOST=127.0.0.1
Environment=PORT=5000
ExecStart=/opt/sms-click-sender/venv/bin/python /opt/sms-click-sender/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
