{
  "name": "sms-click-sender",
  "private": true,
  "version": "0.1.0",
  "description": "Send personalized SMS from an Android phone connected over USB, straight from the browser (or as a downloadable desktop app) using WebUSB - no server-side ADB required.",
  "author": "SMS Click Sender",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.smsclicksender.app",
    "productName": "SMS Click Sender",
    "icon": "electron/assets/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "SMS-Click-Sender-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "SMS-Click-Sender.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "SMS-Click-Sender.${ext}",
      "category": "Utility",
      "synopsis": "Send personalized SMS/WhatsApp from an Android phone over USB"
    }
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
